# Copy to .env (never commit it). python -m dryrun loads .env from the current directory.

# --- market data -------------------------------------------------------------------------------------------
FEED_MODE=sim                  # sim = simulated prices (no account needed) | dhan = live Dhan WebSocket
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=             # 24-hour token from web.dhan.co > My Profile > Access DhanHQ APIs (needs the Data API plan)
FEED_PACKET=quote              # ticker | quote | full  (quote adds volume and day high/low)

# --- server / login ----------------------------------------------------------------------------------------
HOST=127.0.0.1                 # keep loopback and use an SSH tunnel; any other value REQUIRES a login below
PORT=8000
DASHBOARD_PASSWORD=            # set to enable password login (also needed if HOST is not loopback)
SECRET_KEY=                    # any long random string; keeps logins valid across restarts
# AUTH_MODE=email_otp          # later: code by e-mail through Brevo (needs the three lines below)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# ALLOWED_EMAILS=you@example.com

# --- database ----------------------------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/dryrun.db     # PostgreSQL later: postgresql+psycopg://user:pass@host:5432/dryrun
STORE_TICKS=true
TICK_RETENTION_DAYS=30         # raw ticks older than this are deleted; candles and trades are kept

# --- safety ------------------------------------------------------------------------------------------------
STALE_TICK_SECONDS=30          # the risk gate rejects entries if the feed was silent this long before the tick
