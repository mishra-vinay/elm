# Copy to .env (never commit it). Keep comments on their own lines, not after a value.

# --- market data ---
# FEED_MODE: sim = simulated prices (no account needed), dhan = live Dhan WebSocket
FEED_MODE=sim
DHAN_CLIENT_ID=
# 24-hour token from web.dhan.co > My Profile > Access DhanHQ APIs (needs the Data API plan)
DHAN_ACCESS_TOKEN=
# FEED_PACKET: ticker, quote (adds volume and day high/low) or full
FEED_PACKET=quote

# --- server / login ---
# Keep HOST on loopback and use an SSH tunnel; any other value REQUIRES a login below
HOST=127.0.0.1
PORT=8000
# Set to enable password login (also required if HOST is not loopback)
DASHBOARD_PASSWORD=
# Any long random string; keeps logins valid across restarts
SECRET_KEY=
# Later: e-mail code through Brevo (needs the next three settings)
# AUTH_MODE=email_otp
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# ALLOWED_EMAILS=you@example.com

# --- database ---
# PostgreSQL later: postgresql+psycopg://user:pass@host:5432/dryrun
DATABASE_URL=sqlite:///data/dryrun.db
STORE_TICKS=true
# Raw ticks older than this many days are deleted; candles and trades are kept
TICK_RETENTION_DAYS=30

# --- safety ---
# The risk gate rejects entries if the feed was silent this many seconds before the tick
STALE_TICK_SECONDS=30
